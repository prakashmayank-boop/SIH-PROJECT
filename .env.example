# ==============================================================================
# UFIS (UrbanFlood Intelligence System) - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Update the values according to your environment (Local Development vs. AWS Production).
# 3. NEVER commit your actual '.env' file containing real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'staging' | 'production'
ENV=development

# Enable or disable FastAPI debug and Swagger auto-reload (set False for AWS Production)
DEBUG=True

# Application metadata
APP_NAME="UFIS - UrbanFlood Intelligence System"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER BINDING (Uvicorn / Docker)
# ------------------------------------------------------------------------------
# In production on AWS (EC2/ECS/Docker), bind to 0.0.0.0 so external requests reach the app
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# IMPORTANT FOR AWS PRODUCTION:
# Generate a secure 64-character random key using OpenSSL or Python:
#   Linux/macOS: openssl rand -hex 32
#   Python:      python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secure_secret_in_production
JWT_ALGORITHM=HS256

# JWT token lifetime in minutes (1440 min = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Local Development (SQLite file - default if DATABASE_URL is left empty)
# DATABASE_URL=sqlite:///./backend/app/ufis_floodsense.db

# Option B: Docker Container Local Volume
# DATABASE_URL=sqlite:////app/db/ufis_floodsense.db

# Option C: AWS RDS PostgreSQL (Recommended for AWS Production)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
# DATABASE_URL=postgresql://ufis_admin:YourStrongPassword123@ufis-db.cxxxx.ap-south-1.rds.amazonaws.com:5432/ufis_db

# Connection Pool Settings (for PostgreSQL / RDS)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 5. CORS ALLOWED ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list OR JSON array of domains/origins permitted to call the API.
# Include your frontend AWS domain, CloudFront distribution, or EC2 Elastic IP.
# Example: http://localhost:5173,http://your-ec2-ip.compute.amazonaws.com,https://yourdomain.com
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:80", "http://127.0.0.1:80", "http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 6. DEMO OPERATOR CREDENTIALS (Control Room Login)
# ------------------------------------------------------------------------------
# Set credentials for the municipal control room operator account.
# Change these before deploying to production!
DEMO_EMAIL=operator@bbmp.gov.in
DEMO_PASSWORD=admin123
ENABLE_DEMO_LOGIN=True

# ------------------------------------------------------------------------------
# 7. PILOT AREA & MUNICIPAL TENANT
# ------------------------------------------------------------------------------
DEFAULT_TENANT_ID=t-bbmp-blr-01
DEFAULT_CITY_ID=c-blr-01
DEFAULT_ZONE_ID=z-koramangala-151
PILOT_NAME="Bengaluru - Ward 151 (Koramangala)"
CENTER_LAT=12.9345
CENTER_LON=77.6265

# ------------------------------------------------------------------------------
# 8. EMERGENCY SMS GATEWAY & TWILIO INTEGRATION
# ------------------------------------------------------------------------------
# Set to True to simulate SMS dispatch locally without incurring carrier charges.
# Set to False in production once gateway API keys are supplied.
MOCK_SMS_MODE=True

# National Disaster / Carrier Gateway settings (e.g. CDAC / Gov SMS)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=BBMP_UFIS

# Twilio SMS fallback (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 9. GIS & WEATHER RADAR DATA SOURCE
# ------------------------------------------------------------------------------
RADAR_SOURCE=IMD_Bengaluru

# ------------------------------------------------------------------------------
# 10. AWS CLOUD SERVICES (Optional / For AWS Production)
# ------------------------------------------------------------------------------
# AWS Region (ap-south-1 is Mumbai, India)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Bucket for DEM elevation rasters, citizen photo uploads, and report evidence
AWS_S3_BUCKET=ufis-sih-storage-bucket

# ------------------------------------------------------------------------------
# 11. FRONTEND API BASE URL
# ------------------------------------------------------------------------------
# For Local Dev:
VITE_API_BASE=http://127.0.0.1:8000/api/v1
# For AWS Production (when frontend is served behind Nginx reverse proxy):
# VITE_API_BASE=/api/v1
# Or when connecting directly to AWS EC2 backend:
# VITE_API_BASE=http://<YOUR_AWS_EC2_PUBLIC_IP>:8000/api/v1
