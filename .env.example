# ==============================================================================
# UFIS (UrbanFlood Intelligence System) - Environment Configuration Example
# Copy this file to .env and configure the variables accordingly
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Security & Authentication
# IMPORTANT: Generate a strong secret key for production use
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./backend/app/ufis_floodsense.db

# Pilot Area / Tenant Configuration
DEFAULT_TENANT_ID=t-bbmp-blr-01
DEFAULT_CITY_ID=c-blr-01
DEFAULT_ZONE_ID=z-koramangala-151
PILOT_NAME="Bengaluru - Ward 151 (Koramangala)"
CENTER_LAT=12.9345
CENTER_LON=77.6265

# External Services & SMS Gateway (Optional)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=BBMP_UFIS

# GIS / Weather Radar Data Source
RADAR_SOURCE=IMD_Bengaluru

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
