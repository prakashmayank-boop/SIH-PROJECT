# ==============================================================================
# UFIS (UrbanFlood Intelligence System) - Environment Variables
# ==============================================================================

# Application
APP_NAME="UFIS - UrbanFlood Intelligence System"
VERSION="1.0.0"

# Security & JWT
JWT_SECRET_KEY="replace-with-a-random-secure-secret-in-production"
JWT_ALGORITHM="HS256"

# Demo Operator Credentials
DEMO_EMAIL="operator@bbmp.gov.in"
DEMO_PASSWORD="admin123"

# Database Configuration (Defaults to local SQLite if unset)
# DATABASE_URL="postgresql://user:password@localhost:5432/ufis_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# CORS Allowed Origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:80", "http://localhost:3000"]

# SMS & Alert Gateway
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
MOCK_SMS_MODE=True
