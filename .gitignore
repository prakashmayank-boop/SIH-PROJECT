# ==============================================================================
# UFIS (UrbanFlood Intelligence System) - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
package-lock.json.backup
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and Production Outputs
dist/
dist-ssr/
build/
*.local

# Python Environments & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Databases & Runtime State
*.sqlite
*.sqlite3
*.db
backend/app/*.db

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets/

# IDE & Editor Temporary Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
