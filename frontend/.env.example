# ==============================================================================
# UFIS Frontend - Environment Variables Template
# ==============================================================================
# Copy this to '.env' for local dev:
#   cp .env.example .env
#
# For Vercel Production: set these in Vercel Project Settings → Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Local Development (Vite on :5173, Backend on :8000)
# ------------------------------------------------------------------------------
VITE_API_BASE=http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ------------------------------------------------------------------------------
# OPTION 2: Vercel Production via Proxy (Recommended — set in .env.production)
# vercel.json proxies /api/v1/* → EC2 backend, so only relative path needed.
# No Mixed Content browser errors. No CORS issues.
# Update vercel.json → destination to your new EC2 IP if it changes.
# ------------------------------------------------------------------------------
# VITE_API_BASE=/api/v1
# VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# OPTION 3: Direct EC2 Backend (only if NOT using Vercel proxy)
# WARNING: Will cause Mixed Content errors (HTTPS Vercel → HTTP EC2).
# Only use this if you have SSL/HTTPS on EC2 (Nginx + Certbot).
# ------------------------------------------------------------------------------
# VITE_API_BASE=http://13.60.249.74:8000/api/v1
# VITE_API_BASE_URL=http://13.60.249.74:8000/api/v1

# ------------------------------------------------------------------------------
# OPTION 4: Custom Domain with HTTPS (future setup with Nginx + SSL)
# ------------------------------------------------------------------------------
# VITE_API_BASE=https://api.yourdomain.com/api/v1
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
