# ==============================================================================
# UFIS Frontend - Environment Variables Template
# ==============================================================================

# Option 1: Local Development (Vite running on :5173, Backend on :8000)
VITE_API_BASE=http://127.0.0.1:8000/api/v1

# Option 2: Docker Compose / Nginx Reverse Proxy on AWS
# When frontend is served via Nginx which proxies /api/v1 to the backend:
# VITE_API_BASE=/api/v1

# Option 3: AWS EC2 Direct Backend Endpoint (e.g. without reverse proxy)
# VITE_API_BASE=http://<YOUR_AWS_EC2_PUBLIC_IP>:8000/api/v1

# Option 4: Vercel / CloudFront Production Deployment
# Set this in your Vercel Project Settings -> Environment Variables:
# VITE_API_BASE=https://<your-aws-backend-domain>:8000/api/v1
