# ==============================================================================
# UFIS Frontend - Production Environment (Vercel)
# ==============================================================================
# In production on Vercel (served over HTTPS), all browser requests must use the
# relative /api/v1 path. This routes through the Vercel reverse proxy (vercel.json)
# to http://13.60.249.74:8000/api/v1.
#
# WHY THIS IS ESSENTIAL:
# 1. Solves Mixed Content: Browsers block HTTPS -> plain HTTP calls. By using
#    /api/v1, the browser calls HTTPS -> HTTPS (same origin).
# 2. Solves CORS: The request is on the same domain, so browser CORS preflights
#    are bypassed completely.
# ==============================================================================

VITE_API_BASE=/api/v1
VITE_API_BASE_URL=/api/v1
